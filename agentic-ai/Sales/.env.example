API_BASE_URL=http://localhost:5172
AGENT_API_KEY=
# This service's own key — same multi-key plan as Planner's .env.example.
# Optional: without it the priority queue still runs, it just uses the default
# net-value objective and deterministic reasoning text.
GOOGLE_API_KEY=
CHAT_MODEL=gemini-2.5-flash
# Objective used when no model is configured and the caller doesn't ask for one:
# net_value | throughput | margin_per_kg | fifo | export_first
DEFAULT_PRIORITY_OBJECTIVE=net_value