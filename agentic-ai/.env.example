# One .env for the whole agentic-ai service (copy to .env)
API_BASE_URL=http://localhost:5172        # the ASP.NET Core API
AGENT_API_KEY=                            # REQUIRED. Same value as Agent:ApiKey in ASP.NET Core. Empty = service refuses all calls.
GEMINI_API_KEY=                           # Analyzer needs it (empty => workflows end as a recorded safe failure)
# GEMINI_MODEL=models/gemini-3.1-flash-lite-preview
# IMAGE_HOST_ALLOWLIST=cdn.example.org    # extra hosts the Analyzer may fetch images from (the API host is always allowed)
# REPORT_TO_BACKEND=true                  # turn on once the .NET workflow endpoints exist (see BACKEND_CONTRACT.md)
# WORKFLOW_TIMEOUT_SECONDS=120
# MAX_CONCURRENT_WORKFLOWS=4
# MAX_REVISIONS=3
